[Unit]
Description=DNS Lab authoritative tunnel relay
Documentation=file:/etc/dns_lab/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dns_lab
Group=dns_lab
ExecStart=/usr/local/bin/dns_lab serve --config /etc/dns_lab/dns_lab.toml
Restart=on-failure
RestartSec=3

# Allow binding to UDP/TCP 53 without full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Hardening
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dns_lab
StateDirectory=dns_lab

[Install]
WantedBy=multi-user.target
