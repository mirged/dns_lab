# DNS Lab authoritative relay configuration (headless).
#
# Edit with:  sudo dns-lab-config
# Apply with: sudo systemctl restart dns_lab

display_name = "relay"

# UDP + TCP bind address. Port 53 needs CAP_NET_BIND_SERVICE (granted by the
# systemd unit) or root.
listen_addr = "0.0.0.0:53"

# Delegated zone the relay is authoritative for (NS record points here).
zone = "t.example.com"

# Answer SOA/NS for the apex and NXDOMAIN outside the zone.
authoritative = true

# Forward mail for others, with quotas. `client` never forwards; `serve` always
# promotes the relay to authoritative, so this only matters when the unit is
# repurposed as a mailbox-only node.
relay_mode = "authoritative"

# Abuse limits: one host must not be able to fill the disk or the queue.
rate_limit_per_sec = 40        # queries/s per source IP (0 = off)
max_blobs_per_route = 200      # queued blobs per routing tag
max_bytes_per_route = 5242880  # 5 MiB per routing tag

# Relay talks to itself; keep direct. Drop a recursive resolver in `resolver`
# only if you also want the relay to originate outbound queries.
egress = "direct"

# Shared secret.
#
# Leave this EMPTY on a relay: it then routes on opaque tags and can never
# decrypt what it forwards ("blind relay"). Mail addressed to the relay itself
# would not be readable without a key, which is the point.
#
# Set it only if this host also chats, and make it identical to the clients'.
# Generate one with: dns-lab-config --gen-key
shared_key = ""

db_path = "/var/lib/dns_lab/dns_lab.db"

# A relay does not receive files itself, but the client role does.
download_dir = "/var/lib/dns_lab/downloads"

# Seconds between mailbox polls.
poll_interval_secs = 2
